DATABASE_URL=postgresql+psycopg://autopost:autopost@localhost:5433/autopost
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (console.cloud.google.com > API e servizi > Credenziali > ID client OAuth "Applicazione web") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# deve coincidere con un "URI di reindirizzamento autorizzato" del client Google
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Instagram API con login di Instagram (developers.facebook.com > La tua app > Instagram >
# Configurazione API con login di Instagram) ---
# opzionali: senza, il collegamento degli account Instagram risponde 503
# ID e chiave segreta dell'app Instagram, diversi da quelli dell'app Meta
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# deve coincidere con un "URI di reindirizzamento OAuth" in "Configura l'accesso aziendale di Instagram"
INSTAGRAM_REDIRECT_URI=http://localhost:8000/instagram-accounts/oauth/callback
INSTAGRAM_GRAPH_API_VERSION=v24.0

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080

# il JWT viaggia nel cookie HttpOnly AUTH_COOKIE_NAME; true in produzione (solo HTTPS)
AUTH_COOKIE_SECURE=false

# opzionale: dopo il login reindirizza a FRONTEND_URL (token nel cookie) ed è l'origine
# abilitata da CORS; vuoto = il callback risponde con il token in JSON
FRONTEND_URL=
