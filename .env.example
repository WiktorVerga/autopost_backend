DATABASE_URL=postgresql+psycopg://autopost:autopost@localhost:5433/autopost
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (console.cloud.google.com > API e servizi > Credenziali > ID client OAuth "Applicazione web") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# deve coincidere con un "URI di reindirizzamento autorizzato" del client Google
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Instagram API con login di Instagram (developers.facebook.com > La tua app > Instagram >
# Configurazione API con login di Instagram) ---
# opzionali: senza, il collegamento degli account Instagram risponde 503
# ID e chiave segreta dell'app Instagram, diversi da quelli dell'app Meta
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# deve coincidere con un "URI di reindirizzamento OAuth" in "Configura l'accesso aziendale di Instagram"
INSTAGRAM_REDIRECT_URI=http://localhost:8000/instagram-accounts/oauth/callback
INSTAGRAM_GRAPH_API_VERSION=v24.0

# URL pubblico del server: le slide sono servite su PUBLIC_BASE_URL/media/... e Instagram le
# scarica da lì (in locale serve un tunnel, es. ngrok). Vuoto = slide senza URL, solo preview
PUBLIC_BASE_URL=
# --- Cloudflare R2 (dash.cloudflare.com > R2) ---
# opzionale: se tutti impostati le slide vengono caricate nel bucket e servite da R2_PUBLIC_URL
# al posto di PUBLIC_BASE_URL. Token API R2 con permesso "Object Read & Write" sul bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pubblico del bucket: dominio r2.dev abilitato o dominio personalizzato collegato
R2_PUBLIC_URL=
# opzionale: browser per il rendering se mancano il Chromium di Playwright e Chrome/Edge di sistema
CHROME_PATH=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080

# il JWT viaggia nel cookie HttpOnly AUTH_COOKIE_NAME; true in produzione (solo HTTPS)
AUTH_COOKIE_SECURE=false

# opzionale: dopo il login reindirizza a FRONTEND_URL (token nel cookie) ed è l'origine
# abilitata da CORS; vuoto = il callback risponde con il token in JSON
FRONTEND_URL=
