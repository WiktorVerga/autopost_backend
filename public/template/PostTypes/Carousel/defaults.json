{
  "version": 1,
  "postType": "carousel",
  "colors": {
    "background": "#F4F1EA",
    "text": "#1B1A17",
    "muted": "#77726A",
    "accent": "#C2502A",
    "surface": "#E7E1D5"
  },
  "fonts": {
    "heading": {
      "family": "Fraunces",
      "fallback": "serif"
    },
    "body": {
      "family": "Inter",
      "fallback": "sans-serif"
    }
  },
  "typography": {
    "title": {
      "font": "heading",
      "color": "text",
      "size": 84,
      "lineHeight": 1.05,
      "letterSpacing": -0.02,
      "weight": 600,
      "style": "normal",
      "transform": "none",
      "align": "left"
    },
    "subtitle": {
      "font": "heading",
      "color": "text",
      "size": 40,
      "lineHeight": 1.25,
      "letterSpacing": 0,
      "weight": 400,
      "style": "italic",
      "transform": "none",
      "align": "left"
    },
    "body": {
      "font": "body",
      "color": "text",
      "size": 32,
      "lineHeight": 1.45,
      "letterSpacing": 0,
      "weight": 400,
      "style": "normal",
      "transform": "none",
      "align": "left"
    },
    "kicker": {
      "font": "body",
      "color": "accent",
      "size": 22,
      "lineHeight": 1.2,
      "letterSpacing": 0.16,
      "weight": 700,
      "style": "normal",
      "transform": "uppercase",
      "align": "left"
    },
    "number": {
      "font": "heading",
      "color": "accent",
      "size": 220,
      "lineHeight": 0.95,
      "letterSpacing": -0.03,
      "weight": 600,
      "style": "normal",
      "transform": "none",
      "align": "left"
    },
    "meta": {
      "font": "body",
      "color": "muted",
      "size": 20,
      "lineHeight": 1.2,
      "letterSpacing": 0.08,
      "weight": 500,
      "style": "normal",
      "transform": "uppercase",
      "align": "left"
    }
  },
  "spacing": {
    "title": {
      "paddingX": 0,
      "paddingY": 0,
      "marginX": 0,
      "marginY": 14
    },
    "subtitle": {
      "paddingX": 0,
      "paddingY": 0,
      "marginX": 0,
      "marginY": 10
    },
    "body": {
      "paddingX": 0,
      "paddingY": 0,
      "marginX": 0,
      "marginY": 10
    },
    "kicker": {
      "paddingX": 0,
      "paddingY": 0,
      "marginX": 0,
      "marginY": 18
    },
    "number": {
      "paddingX": 0,
      "paddingY": 0,
      "marginX": 0,
      "marginY": 6
    },
    "meta": {
      "paddingX": 0,
      "paddingY": 0,
      "marginX": 0,
      "marginY": 0
    }
  },
  "layout": {
    "paddingX": 96,
    "paddingY": 80,
    "coverTitleScale": 1.3,
    "frameInset": 28,
    "frameWidth": 2
  },
  "visibility": {
    "global": {
      "handle": true,
      "category": true,
      "pageNumber": true,
      "pageTotal": true,
      "kicker": true,
      "kickerRule": true,
      "progressBar": true,
      "frame": false,
      "watermark": false
    },
    "cover": {
      "subtitle": true,
      "slideHint": true,
      "slideHintArrow": true,
      "pageNumber": false
    },
    "text": {
      "title": true
    },
    "number": {
      "caption": true,
      "body": true
    },
    "steps": {
      "index": true,
      "descriptions": true,
      "dividers": true
    },
    "compare": {
      "labels": true,
      "divider": true,
      "surface": false,
      "bullets": true
    },
    "myth": {
      "labels": true,
      "strike": true,
      "factSurface": true
    },
    "tip": {
      "mark": true,
      "note": true
    },
    "closing": {
      "body": true,
      "cta": true,
      "ctaArrow": true,
      "handle": false
    }
  }
}